---
import '../styles/hero.css';
import companies from '../data/companies.json';

const tickerCopies = 3;
---

<section class="hero">
  <div class="hero__visual" aria-hidden="true">
    <img
    class="hero__visual-base"
    src="/images/tumbler_segment.svg"
    alt="segment"
  />

  <img
    class="hero__visual-pawl"
    src="/images/pawl.svg"
    alt="pawl"
  />
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1>Michael Mehmet</h1>

      <p class="hero__role">Senior Software Engineer</p>

      <p class="hero__mission">
        I build robust solutions to hard problems.<br />
        The tools and systems I bring can be used, understood, and trusted by anyone.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="#experience">
          Explore my experience
        </a>

        <a class="button button--secondary" href="#focus">
          Explore what I can build
        </a>
      </div>
    </div>

    <div class="hero__ticker-wrap">
        <div class="hero__ticker-viewport">
          <div class="hero__ticker-track">
            {
              Array.from({ length: tickerCopies }).map((_, groupIndex) => (
                <div
                  class="hero__ticker-group"
                  aria-hidden={groupIndex > 0 ? 'true' : undefined}
                >
                  {
                    companies.map((company) => (
                      <a
                        class="hero__ticker-item"
                        href={company.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        tabindex={groupIndex > 0 ? '-1' : undefined}
                      >
                        <img src={company.logo} alt="" />
                        <span>{company.name}</span>
                      </a>
                    ))
                  }
                </div>
              ))
            }
          </div>
        </div>
    </div>
  </div>
</section>