---
import '../styles/hero.css';

const name = 'Mic Mehmet';
---

<section class="hero" aria-labelledby="hero-story">
  <img src="/images/f1_montage.webp" class="hero__film" alt="" />

  <div class="hero__wash" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="hero__story">
    <h1 id="hero-story" class="hero__setup">
      <span>If you have a problem,</span>
      <span>if you need the absolute best,</span>
      <span>and if he&rsquo;s available,</span>
      <span>maybe you can hire...</span>
    </h1>

    <a
      class="hero__name"
      href="#story"
      aria-label="Begin the story"
    >
      {
        [...name].map((letter, index) => (
          <span
            class:list={['hero__letter', { 'hero__letter--space': letter === ' ' }]}
            style={`--letter-index: ${index}`}
            aria-hidden="true"
          >
            {letter === ' ' ? '\u00a0' : letter}
          </span>
        ))
      }
    </a>
  </div>
</section>
