---
import '../styles/hero.css';
---

<section class="hero">
  <div class="hero__visual" aria-hidden="true">
    <img
    class="hero__visual-base"
    src="/images/tumbler_segment.svg"
    alt="segment"
  />

  <img
    class="hero__visual-pawl"
    src="/images/pawl.svg"
    alt="pawl"
  />
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__role">Senior Software Engineer</p>

      <h1>Michael Mehmet</h1>

      <p class="hero__mission">
        I build robust tools to solve hard problems, always choosing the right
        technologies and methods, while designing systems around them that
        people use, understand, and trust.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="#experience">
          Explore my experience
        </a>

        <a class="button button--secondary" href="#focus">
          See what I’m building now
        </a>
      </div>
    </div>

    <div class="hero__ticker-wrap">
        <div class="hero__ticker-viewport">
            <div class="hero__ticker-track">

            <div class="hero__ticker-group">
                <a
                class="hero__ticker-item"
                href="https://automedsystems.com.au/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/automed.png" alt="" />
                <span>Automed</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://www.glowfeed.com/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/glow.png" alt="" />
                <span>Glow</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://banxa.com/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/banxa.jpg" alt="" />
                <span>Banxa</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://thepistol.com.au/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/the-pistol.jpg" alt="" />
                <span>The Pistol</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://tallbob.com/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/tallbob.png" alt="" />
                <span>Tall Bob</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://www.eonx.com/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/eonx.jpg" alt="" />
                <span>EonX</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://zibdigital.com.au/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/zib.png" alt="" />
                <span>Zib Digital</span>
                </a>

                <a
                class="hero__ticker-item"
                href="https://eledger.com.au/"
                target="_blank"
                rel="noopener noreferrer"
                >
                <img src="/logos/eledger.png" alt="" />
                <span>eLedger</span>
                </a>
            </div>

            <div class="hero__ticker-group" aria-hidden="true">
                <a
