---
import '../styles/foundation.css';
import projects from '../data/projects.json';
---

<section id="foundation" class="foundation section">
  <div class="container">
    <div class="foundation__intro">
      <p class="eyebrow">Foundation</p>

      <h2>
        Curiosity doesn’t stop <span>when the workday does.</span>
      </h2>

      <p class="lead">
        I’ve always built things outside work as well — sometimes because I
        needed them, sometimes because I wanted to understand how they worked,
        and sometimes simply because they seemed worth making.
      </p>
    </div>

    <div class="foundation__projects">
      {
        projects.map((project, index) => (
          <article class={`foundation-project foundation-project--${(index % 5) + 1}`}>
            <span class="foundation-project__number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </article>
        ))
      }
    </div>

    <div class="foundation__education">
      <div class="foundation__education-heading">
        <p class="eyebrow">Education</p>
        <h3>The academic foundation.</h3>
      </div>

      <div class="foundation__degrees">
        <article>
          <span>MA</span>
          <div>
            <strong>Cognitive Science</strong>
            <p>University of New South Wales</p>
          </div>
        </article>

        <article>
          <span>BSc</span>
          <div>
            <strong>Science &amp; Mathematics</strong>
            <p>University of New South Wales</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>