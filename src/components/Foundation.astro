---
import '../styles/foundation.css';
import projects from '../data/projects.json';
---

<section id="foundation" class="foundation" data-foundation-stage aria-label="Foundation">
  <article class="foundation__panel" data-foundation-panel>
    <div class="foundation__visual">
      <picture>
        <source media="(max-width: 700px)" srcset="/images/story/harvey-resp.webp" />
        <img
          src="/images/story/harvey.webp"
          alt="Two suited colleagues reviewing a candidate on a tablet"
        />
      </picture>
    </div>

    <div class="foundation__copy">
      <p>
        “This guy has a solid foundation and he builds AI projects for fun.
        Why isn&rsquo;t he working for us?”
      </p>
    </div>

    <button
      class="foundation__back"
      type="button"
      aria-label="Return to the Experience index"
    />

    <button
      class="foundation__forward"
      type="button"
      aria-label="View projects, education, and links"
    />
  </article>

  <div
    class="foundation__grid fullscreen-grid"
    data-foundation-grid
    aria-label="Projects, education, and links"
    hidden
  >
    {
      projects.map((project, index) => (
        <article class={`foundation-tile foundation-tile--project foundation-tile--${index + 1} fullscreen-grid__item`}>
          <h2>{project.name}</h2>
          <p>{project.description}</p>
        </article>
      ))
    }

    <a
      class="foundation-tile foundation-tile--blank fullscreen-grid__item"
      href="/demo"
      aria-label="Open demo"
    ></a>

    <article class="foundation-tile foundation-tile--education fullscreen-grid__item">
      <span class="foundation-tile__label">Education</span>

      <div class="foundation-tile__degrees">
        <div class="foundation-degree">
          <strong>MA</strong>
          <div>
            <h2>Cognitive Science</h2>
            <p>University of New South Wales</p>
          </div>
        </div>

        <div class="foundation-degree">
          <strong>BSc</strong>
          <div>
            <h2>Science &amp; Mathematics</h2>
            <span>Computing major</span>
            <p>University of New South Wales</p>
          </div>
        </div>
      </div>
    </article>

    <nav class="foundation-tile foundation-tile--links fullscreen-grid__item" aria-label="Links">
      <span class="foundation-tile__label">Links</span>
      <a href="/downloads/MMCV.pdf" download>Download CV</a>
      <a href="https://github.com/mmehmet" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/micmehmet" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</section>

<script>
  const foundation = document.querySelector<HTMLElement>('[data-foundation-stage]');
  const panel = document.querySelector<HTMLElement>('[data-foundation-panel]');
  const grid = document.querySelector<HTMLElement>('[data-foundation-grid]');
  const back = document.querySelector<HTMLButtonElement>('.foundation__back');
  const forward = document.querySelector<HTMLButtonElement>('.foundation__forward');
  const navigationWindow = window as typeof window & {
    __foundationNavigationController?: AbortController;
  };
  navigationWindow.__foundationNavigationController?.abort();
  const navigationController = new AbortController();
  navigationWindow.__foundationNavigationController = navigationController;
  const navigationSignal = navigationController.signal;
  let gridVisible = false;
  let wheelLocked = false;
  let wheelReleaseTimer = 0;
  let touchStartY = 0;
  let touchCurrentY = 0;
  const routeNavigationLockKey = 'full-page-navigation-lock-until';

  const routeNavigationIsLocked = () => {
    try {
      const isLocked = Number(window.sessionStorage.getItem(routeNavigationLockKey)) > Date.now();
      if (isLocked) {
        window.sessionStorage.setItem(routeNavigationLockKey, String(Date.now() + 350));
      } else {
        window.sessionStorage.removeItem(routeNavigationLockKey);
      }
      return isLocked;
    } catch {
      return false;
    }
  };

  const lockRouteNavigation = () => {
    try {
      window.sessionStorage.setItem(routeNavigationLockKey, String(Date.now() + 500));
    } catch {
      // Navigation still works when session storage is unavailable.
    }
  };

  const syncFoundationUrl = () => {
    const target = gridVisible ? '/foundation#grid' : '/foundation';
    if (`${window.location.pathname}${window.location.hash}` !== target) {
      window.history.replaceState(window.history.state, '', target);
    }
  };

  const showGrid = () => {
    if (!panel || !grid || gridVisible) return;
    panel.setAttribute('hidden', '');
    grid.removeAttribute('hidden');
    gridVisible = true;
    syncFoundationUrl();
  };

  const showPanel = () => {
    if (!panel || !grid || !gridVisible) return;
    grid.setAttribute('hidden', '');
    panel.removeAttribute('hidden');
    gridVisible = false;
    syncFoundationUrl();
  };

  const showExperienceIndex = () => {
    lockRouteNavigation();
    window.location.assign('/experience');
  };

  back?.addEventListener('click', showExperienceIndex, { signal: navigationSignal });
  forward?.addEventListener('click', showGrid, { signal: navigationSignal });

  window.addEventListener('wheel', (event) => {
    if (!foundation) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    if (routeNavigationIsLocked()) return;

    const direction = Math.sign(event.deltaY);
    if (!direction) return;

    if (wheelLocked) {
      window.clearTimeout(wheelReleaseTimer);
      wheelReleaseTimer = window.setTimeout(() => {
        wheelLocked = false;
      }, 300);
      return;
    }

    wheelLocked = true;

    if (gridVisible) {
      if (direction < 0) showPanel();
    } else if (direction < 0) {
      showExperienceIndex();
    } else {
      showGrid();
    }

    window.clearTimeout(wheelReleaseTimer);
    wheelReleaseTimer = window.setTimeout(() => {
      wheelLocked = false;
    }, 300);
  }, { passive: false, capture: true, signal: navigationSignal });

  foundation?.addEventListener('touchstart', (event) => {
    touchStartY = event.touches[0]?.clientY ?? 0;
    touchCurrentY = touchStartY;
  }, { passive: true, signal: navigationSignal });

  foundation?.addEventListener('touchmove', (event) => {
    touchCurrentY = event.touches[0]?.clientY ?? touchCurrentY;
    if (Math.abs(touchStartY - touchCurrentY) > 8) event.preventDefault();
  }, { passive: false, signal: navigationSignal });

  foundation?.addEventListener('touchend', () => {
    const distance = touchStartY - touchCurrentY;
    if (Math.abs(distance) < 45 || routeNavigationIsLocked()) return;

    const direction = Math.sign(distance);
    if (gridVisible) {
      if (direction < 0) showPanel();
    } else if (direction < 0) {
      showExperienceIndex();
    } else {
      showGrid();
    }
  }, { signal: navigationSignal });

  document.addEventListener('keydown', (event) => {
    if (['ArrowDown', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();
      if (!gridVisible) showGrid();
    }

    if (['ArrowUp', 'PageUp'].includes(event.key)) {
      event.preventDefault();
      if (gridVisible) showPanel();
      else showExperienceIndex();
    }
  }, { signal: navigationSignal });

  if (window.location.hash === '#grid') showGrid();

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#grid') showGrid();
    else showPanel();
  }, { signal: navigationSignal });
</script>
