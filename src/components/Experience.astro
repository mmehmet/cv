---
import '../styles/experience.css';
import companies from '../data/companies.json';
import experience from '../data/experience.json';

const formatYear = (value: string | null) => {
  if (!value) return 'Present';
  return value.slice(0, 4);
};

const visibleExperience = experience;
const tickerCopies = 3;
---

<section id="experience" class="experience section section--light">
  <div id="experience-slides" class="experience__deck">
    <div class="experience__home">
      <div class="experience__index fullscreen-grid" aria-label="Select an employer">
        <div class="experience__intro-tile fullscreen-grid__item">
          <div class="experience__copy">
            <p class="eyebrow">Mic Mehmet: Gun for hire</p>
          </div>

          <div class="experience__image" aria-hidden="true">
            <img src="/images/tallbob-api.png" alt="" />
          </div>
        </div>

        {
          visibleExperience.map((item, index) => (
            <button
              class="experience-index-card fullscreen-grid__item"
              type="button"
              data-experience-target={index + 1}
            >
              <span class="experience-index-card__dates">
                {formatYear(item.start)} – {formatYear(item.end)}
              </span>
              <strong>{item.company}</strong>
              <span class="experience-index-card__summary">
                {item.summary}
              </span>
            </button>
          ))
        }
      </div>

      <div class="experience-ticker" aria-label="Select an employer by logo">
        <div class="experience-ticker__track">
          {
            Array.from({ length: tickerCopies }).map((_, groupIndex) => (
              <div
                class="experience-ticker__group"
                aria-hidden={groupIndex > 0 ? 'true' : undefined}
              >
                {
                  companies.map((company, index) => (
                    <button
                      class="experience-ticker__item"
                      type="button"
                      data-experience-target={index + 1}
                      tabindex={groupIndex > 0 ? '-1' : undefined}
                    >
                      <img src={company.logo} alt="" />
                      <span>{company.name}</span>
                    </button>
                  ))
                }
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <dialog class="experience-modal" aria-label="Experience details" tabindex="-1">
      {
        visibleExperience.map((item, index) => (
          <article
            id={index === visibleExperience.length - 1 ? 'final' : `experience-slide-${index + 1}`}
            class:list={[
              'experience-panel',
              {
                'experience-panel--dense': item.description.length > 800,
                'experience-panel--very-dense': item.description.length > 1000,
              },
            ]}
            data-experience-panel
            aria-labelledby={`experience-panel-title-${index + 1}`}
            hidden
          >
            <header class="experience-panel__header">
              <img src={companies[index].logo} alt="" aria-hidden="true" />
              <h2 id={`experience-panel-title-${index + 1}`}>{item.company}</h2>
            </header>

            <div class="experience-panel__body">
              <p class="experience-panel__description">
                {item.description}
              </p>
            </div>

            <footer class="experience-panel__footer">
              <span class="experience-panel__dates">
                {formatYear(item.start)} – {formatYear(item.end)}
              </span>

              <div class="experience-panel__tags">
                {
                  item.technologies.slice(0, 4).map((technology) => (
                    <span>{technology}</span>
                  ))
                }
              </div>
            </footer>
          </article>
        ))
      }
    </dialog>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.experience');
  const modal = document.querySelector<HTMLDialogElement>('.experience-modal');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-experience-panel]'));
  const indexCards = document.querySelectorAll<HTMLButtonElement>('[data-experience-target]');
  const navigationWindow = window as typeof window & {
    __experienceNavigationController?: AbortController;
  };
  navigationWindow.__experienceNavigationController?.abort();
  const navigationController = new AbortController();
  navigationWindow.__experienceNavigationController = navigationController;
  const navigationSignal = navigationController.signal;
  let activeIndex = -1;
  let wheelLocked = false;
  let wheelReleaseTimer = 0;
  let touchStartY = 0;
  let touchCurrentY = 0;
  const routeNavigationLockKey = 'full-page-navigation-lock-until';

  const routeNavigationIsLocked = () => {
    try {
      const isLocked = Number(window.sessionStorage.getItem(routeNavigationLockKey)) > Date.now();
      if (isLocked) {
        window.sessionStorage.setItem(routeNavigationLockKey, String(Date.now() + 350));
      } else {
        window.sessionStorage.removeItem(routeNavigationLockKey);
      }
      return isLocked;
    } catch {
      return false;
    }
  };

  const lockRouteNavigation = () => {
    try {
      window.sessionStorage.setItem(routeNavigationLockKey, String(Date.now() + 500));
    } catch {
      // Navigation still works when session storage is unavailable.
    }
  };

  const syncPanelUrl = () => {
    const target = activeIndex === panels.length - 1
      ? '/experience#final'
      : '/experience';

    if (`${window.location.pathname}${window.location.hash}` !== target) {
      window.history.replaceState(window.history.state, '', target);
    }
  };

  const showPanel = (nextIndex: number) => {
    if (!modal || nextIndex < 0 || nextIndex >= panels.length || nextIndex === activeIndex) return;

    panels[activeIndex]?.setAttribute('hidden', '');
    panels[activeIndex]?.setAttribute('aria-hidden', 'true');
    activeIndex = nextIndex;
    panels[activeIndex]?.removeAttribute('hidden');
    panels[activeIndex]?.setAttribute('aria-hidden', 'false');
    modal.setAttribute('aria-labelledby', `experience-panel-title-${activeIndex + 1}`);

    if (!modal.open) modal.showModal();
    modal.focus({ preventScroll: true });
    syncPanelUrl();
  };

  const closeModal = () => {
    if (!modal || activeIndex < 0) return;

    panels[activeIndex]?.setAttribute('hidden', '');
    panels[activeIndex]?.setAttribute('aria-hidden', 'true');
    activeIndex = -1;
    if (modal.open) modal.close();
    syncPanelUrl();
  };

  const showFinalStoryPanel = () => {
    lockRouteNavigation();
    window.location.assign('/#final');
  };

  const showFoundation = () => {
    lockRouteNavigation();
    window.location.assign('/foundation');
  };

  indexCards.forEach((card) => {
    card.addEventListener('click', () => {
      showPanel(Number(card.dataset.experienceTarget) - 1);
    }, { signal: navigationSignal });
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  }, { signal: navigationSignal });

  modal?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeModal();
  }, { signal: navigationSignal });

  window.addEventListener('wheel', (event) => {
    if (!section) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    if (routeNavigationIsLocked()) return;

    const direction = Math.sign(event.deltaY);
    if (!direction) return;

    if (wheelLocked) {
      window.clearTimeout(wheelReleaseTimer);
      wheelReleaseTimer = window.setTimeout(() => {
        wheelLocked = false;
      }, 300);
      return;
    }

    wheelLocked = true;

    if (modal?.open) {
      const nextIndex = activeIndex + direction;
      if (nextIndex >= 0 && nextIndex < panels.length) showPanel(nextIndex);
    } else if (direction < 0) {
      showFinalStoryPanel();
    } else {
      showFoundation();
    }

    window.clearTimeout(wheelReleaseTimer);
    wheelReleaseTimer = window.setTimeout(() => {
      wheelLocked = false;
    }, 300);
  }, { passive: false, capture: true, signal: navigationSignal });

  section?.addEventListener('touchstart', (event) => {
    touchStartY = event.touches[0]?.clientY ?? 0;
    touchCurrentY = touchStartY;
  }, { passive: true, signal: navigationSignal });

  section?.addEventListener('touchmove', (event) => {
    touchCurrentY = event.touches[0]?.clientY ?? touchCurrentY;
    if (Math.abs(touchStartY - touchCurrentY) > 8) event.preventDefault();
  }, { passive: false, signal: navigationSignal });

  section?.addEventListener('touchend', () => {
    const distance = touchStartY - touchCurrentY;
    if (Math.abs(distance) < 45) return;

    const direction = Math.sign(distance);

    if (modal?.open) {
      const nextIndex = activeIndex + direction;
      if (nextIndex >= 0 && nextIndex < panels.length) showPanel(nextIndex);
    } else if (direction < 0) {
      showFinalStoryPanel();
    } else {
      showFoundation();
    }
  }, { signal: navigationSignal });

  document.addEventListener('keydown', (event) => {
    if (!section || document.body.classList.contains('story-active')) return;

    const bounds = section.getBoundingClientRect();
    const experienceIsVisible = bounds.top <= 1 && bounds.bottom >= window.innerHeight - 1;
    if (!experienceIsVisible) return;

    if (event.key === 'Escape' && modal?.open) {
      event.preventDefault();
      closeModal();
      return;
    }

    if (['ArrowDown', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();
      if (!modal?.open) showFoundation();
      else if (activeIndex < panels.length - 1) showPanel(activeIndex + 1);
    }

    if (['ArrowUp', 'PageUp'].includes(event.key)) {
      event.preventDefault();
      if (!modal?.open) showFinalStoryPanel();
      else if (activeIndex > 0) showPanel(activeIndex - 1);
    }
  }, { signal: navigationSignal });

  if (window.location.hash === '#final') {
    showPanel(panels.length - 1);
  }

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#final') showPanel(panels.length - 1);
  }, { signal: navigationSignal });
</script>
