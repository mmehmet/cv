---
import '../styles/story.css';

const panels = [
  {
    image: '/images/story/brief.webp',
    portrait: '/images/story/brief-resp.webp',
    alt: 'A project lead is handed a difficult brief',
    copy: "Here's the new brief. We need to get someone in for it.",
  },
  {
    image: '/images/story/sharks.webp',
    portrait: '/images/story/sharks-resp.webp',
    alt: 'Mic is fighting sharks',
    copy: "You need someone with a particular set of skills...",
    kind: 'thought',
  },
  {
    image: '/images/story/explody.webp',
    portrait: '/images/story/explody-resp.webp',
    alt: 'Mic runs from an explosion',
    copy: "Someone you just drop in and they the ground running.",
    kind: 'thought',
  },
  {
    image: '/images/story/phone-guy.webp',
    portrait: '/images/story/phone-guy-resp.webp',
    alt: 'The project lead reaches out to Ari',
    copy: 'I need a hired gun – can you help me out?',
  },
  {
    image: '/images/story/ari.webp',
    portrait: '/images/story/ari-resp.webp',
    alt: 'Ari answers the phone from his office',
    copy: "I got just the guy! I'll send you his details.",
  },
  {
    image: '/images/story/message.webp',
    portrait: '/images/story/message-resp.webp',
    alt: 'A phone lights up with a new message',
    final: true,
  },
];
---

<section
  id="story"
  class="story"
  data-story-stage
  aria-label="The search for the right hired gun"
>
  {
    panels.map((panel, index) => {
      return (
        <article
          id={`story-panel-${index + 1}`}
          class="story__panel"
          hidden={index !== 0}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="story__visual">
            {
              panel.portrait ? (
                <picture>
                  <source media="(max-width: 700px)" srcset={panel.portrait} />
                  <img src={panel.image} alt={panel.alt} />
                </picture>
              ) : (
                <img src={panel.image} alt={panel.alt} />
              )
            }
          </div>

          {
            panel.copy && (
              <div class:list={['story__copy', { 'story__copy--final': panel.final }]}>
                {
                  panel.final ? (
                    <a class="story__message" href="#experience">
                      “{panel.copy}”
                    </a>
                  ) : (
                    <p class:list={['story__text', { 'story__text--thought': panel.kind === 'thought' }]}>
                      {panel.kind === 'thought' ? panel.copy : `“${panel.copy}”`}
                    </p>
                  )
                }
              </div>
            )
          }

          <button
            class="story__back"
            type="button"
            data-story-back
            aria-label={index === 0 ? 'Return to the landing page' : 'Return to the previous panel'}
          />

          {
            panel.final ? (
              <button
                class="story__advance story__finish"
                type="button"
                data-story-finish
                aria-label="Continue to the Experience section"
              />
            ) : (
              <button
                class="story__advance"
                type="button"
                data-story-advance
                aria-label="Continue to the next part of the story"
              />
            )
          }
        </article>
      );
    })
  }
</section>

<script>
  import {
    createWheelStepDetector,
    lockWheelRouteNavigation,
    wheelRouteNavigationIsLocked,
  } from '../scripts/wheel-navigation';

  const root = document.documentElement;
  const body = document.body;
  const mobileQuery = window.matchMedia('(max-width: 700px)');
  const hero = document.querySelector<HTMLElement>('.hero');
  const heroLink = document.querySelector<HTMLAnchorElement>('.hero__name');
  const story = document.querySelector<HTMLElement>('[data-story-stage]');
  const storyPanels = Array.from(document.querySelectorAll<HTMLElement>('.story__panel'));
  let activeIndex = 0;
  let wheelLocked = false;
  let wheelDirection = 0;
  let wheelReleaseTimer = 0;
  let transitionLocked = false;
  let transitionReleaseTimer = 0;
  let touchStartY = 0;
  let touchCurrentY = 0;
  let touchStartX = 0;
  let touchCurrentX = 0;
  let landingTouchStartY = 0;
  let landingTouchCurrentY = 0;
  let landingTouchStartX = 0;
  let landingTouchCurrentX = 0;
  const detectWheelStep = createWheelStepDetector();

  const getRawScrollDirection = (event: WheelEvent) => {
    const horizontalScroll = mobileQuery.matches && Math.abs(event.deltaX) > Math.abs(event.deltaY);
    return Math.sign(horizontalScroll ? event.deltaX : event.deltaY);
  };
  const getScrollDirection = (event: WheelEvent) => detectWheelStep(event, mobileQuery.matches);

  const setStoryHeight = () => {
    if (mobileQuery.matches) {
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      root.style.setProperty('--story-mobile-height', `${Math.round(viewportHeight)}px`);
    } else {
      root.style.removeProperty('--story-mobile-height');
    }
  };

  const showPanel = (nextIndex: number, force = false) => {
    if (nextIndex < 0 || nextIndex >= storyPanels.length || (!force && nextIndex === activeIndex)) return;

    storyPanels[activeIndex]?.setAttribute('hidden', '');
    storyPanels[activeIndex]?.setAttribute('aria-hidden', 'true');

    activeIndex = nextIndex;

    storyPanels[activeIndex]?.removeAttribute('hidden');
    storyPanels[activeIndex]?.setAttribute('aria-hidden', 'false');
  };

  const showLanding = () => {
    root.classList.add('story-is-jumping');
    body.classList.remove('story-active');
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });

    requestAnimationFrame(() => {
      root.classList.remove('story-is-jumping');
    });
  };

  const showStory = () => {
    showPanel(0);
    root.classList.add('story-is-jumping');
    body.classList.add('story-active');
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });

    requestAnimationFrame(() => {
      root.classList.remove('story-is-jumping');
    });
  };

  const showExperience = (wheelDirection = 0) => {
    lockWheelRouteNavigation(wheelDirection);
    window.location.assign('/experience');
  };

  const showFinalStoryPanel = () => {
    showPanel(storyPanels.length - 1, true);

    transitionLocked = true;
    wheelLocked = true;
    wheelDirection = -1;
    window.clearTimeout(transitionReleaseTimer);
    window.clearTimeout(wheelReleaseTimer);

    transitionReleaseTimer = window.setTimeout(() => {
      transitionLocked = false;
    }, 220);

    wheelReleaseTimer = window.setTimeout(() => {
      wheelLocked = false;
      wheelDirection = 0;
    }, 220);

    root.classList.add('story-is-jumping');
    body.classList.add('story-active', 'story-locked');
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });

    requestAnimationFrame(() => {
      root.classList.remove('story-is-jumping');
    });
  };

  setStoryHeight();
  body.classList.add('story-locked');

  if (window.location.hash === '#final') {
    showFinalStoryPanel();
  } else {
    window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
  }

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#final') showFinalStoryPanel();
  });
  window.addEventListener('resize', setStoryHeight);
  window.addEventListener('orientationchange', setStoryHeight);
  window.visualViewport?.addEventListener('resize', setStoryHeight);
  mobileQuery.addEventListener('change', setStoryHeight);

  document.querySelectorAll<HTMLButtonElement>('[data-story-advance]').forEach((button) => {
    button.addEventListener('click', () => {
      showPanel(activeIndex + 1);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-story-back]').forEach((button) => {
    button.addEventListener('click', () => {
      if (activeIndex === 0) {
        showLanding();
      } else {
        showPanel(activeIndex - 1);
      }
    });
  });

  document.querySelector<HTMLButtonElement>('[data-story-finish]')?.addEventListener('click', () => {
    showExperience();
  });

  heroLink?.addEventListener('click', (event) => {
    event.preventDefault();
    showStory();
  });

  document.querySelector<HTMLAnchorElement>('.story__message')?.addEventListener('click', (event) => {
    event.preventDefault();
    showExperience();
  });

  hero?.addEventListener('wheel', (event) => {
    const direction = getScrollDirection(event);
    if (direction <= 0) {
      if (!direction && event.deltaY > 0) event.preventDefault();
      return;
    }

    if (wheelRouteNavigationIsLocked(direction)) {
      event.preventDefault();
      return;
    }

    event.preventDefault();
    if (wheelLocked) return;

    wheelLocked = true;
    wheelDirection = 1;
    showStory();

    wheelReleaseTimer = window.setTimeout(() => {
      wheelLocked = false;
      wheelDirection = 0;
    }, 180);
  }, { passive: false });

  hero?.addEventListener('touchstart', (event) => {
    landingTouchStartX = event.touches[0]?.clientX ?? 0;
    landingTouchCurrentX = landingTouchStartX;
    landingTouchStartY = event.touches[0]?.clientY ?? 0;
    landingTouchCurrentY = landingTouchStartY;
  }, { passive: true });

  hero?.addEventListener('touchmove', (event) => {
    landingTouchCurrentX = event.touches[0]?.clientX ?? landingTouchCurrentX;
    landingTouchCurrentY = event.touches[0]?.clientY ?? landingTouchCurrentY;
    const horizontalDistance = Math.abs(landingTouchStartX - landingTouchCurrentX);
    const verticalDistance = landingTouchStartY - landingTouchCurrentY;
    if (verticalDistance > 8 || (mobileQuery.matches && horizontalDistance > 8)) event.preventDefault();
  }, { passive: false });

  hero?.addEventListener('touchend', () => {
    const horizontalDistance = landingTouchStartX - landingTouchCurrentX;
    const verticalDistance = landingTouchStartY - landingTouchCurrentY;
    const distance = mobileQuery.matches && Math.abs(horizontalDistance) > Math.abs(verticalDistance)
      ? horizontalDistance
      : verticalDistance;
    if (distance >= 45) showStory();
  });

  story?.addEventListener('wheel', (event) => {
    const direction = getScrollDirection(event);
    const atBoundary =
      (direction < 0 && activeIndex === 0) ||
      (direction > 0 && activeIndex === storyPanels.length - 1);

    if (!direction) return;

    if (wheelRouteNavigationIsLocked(direction)) {
      event.preventDefault();
      return;
    }

    if (wheelLocked) {
      event.preventDefault();
      return;
    }

    if (atBoundary) {
      if (direction < 0 && activeIndex === 0) {
        event.preventDefault();
        wheelLocked = true;
        wheelDirection = -1;
        showLanding();

        wheelReleaseTimer = window.setTimeout(() => {
          wheelLocked = false;
          wheelDirection = 0;
        }, 180);
      }

      if (direction > 0 && activeIndex === storyPanels.length - 1) {
        event.preventDefault();
        wheelLocked = true;
        wheelDirection = 1;
        showExperience(direction);

        wheelReleaseTimer = window.setTimeout(() => {
          wheelLocked = false;
          wheelDirection = 0;
        }, 180);
      }

      return;
    }

    event.preventDefault();
    wheelLocked = true;
    wheelDirection = direction;
    showPanel(activeIndex + direction);

    wheelReleaseTimer = window.setTimeout(() => {
      wheelLocked = false;
      wheelDirection = 0;
    }, 180);
  }, { passive: false });

  window.addEventListener('wheel', (event) => {
    if (!wheelLocked) return;

    const direction = getRawScrollDirection(event);

    if (direction && direction !== wheelDirection) {
      window.clearTimeout(wheelReleaseTimer);
      wheelLocked = false;
      wheelDirection = 0;
      return;
    }

    event.preventDefault();
  }, { passive: false, capture: true });

  story?.addEventListener('touchstart', (event) => {
    touchStartX = event.touches[0]?.clientX ?? 0;
    touchCurrentX = touchStartX;
    touchStartY = event.touches[0]?.clientY ?? 0;
    touchCurrentY = touchStartY;
  }, { passive: true });

  story?.addEventListener('touchmove', (event) => {
    touchCurrentX = event.touches[0]?.clientX ?? touchCurrentX;
    touchCurrentY = event.touches[0]?.clientY ?? touchCurrentY;
    const horizontalDistance = touchStartX - touchCurrentX;
    const verticalDistance = touchStartY - touchCurrentY;
    const distance = mobileQuery.matches && Math.abs(horizontalDistance) > Math.abs(verticalDistance)
      ? horizontalDistance
      : verticalDistance;
    const direction = Math.sign(distance);
    const atBoundary =
      (direction < 0 && activeIndex === 0) ||
      (direction > 0 && activeIndex === storyPanels.length - 1);

    const returningToLanding = direction < 0 && activeIndex === 0;
    const continuingToExperience = direction > 0 && activeIndex === storyPanels.length - 1;
    if (Math.abs(distance) > 8 && (!atBoundary || returningToLanding || continuingToExperience)) {
      event.preventDefault();
    }
  }, { passive: false });

  story?.addEventListener('touchend', () => {
    if (transitionLocked) return;

    const horizontalDistance = touchStartX - touchCurrentX;
    const verticalDistance = touchStartY - touchCurrentY;
    const distance = mobileQuery.matches && Math.abs(horizontalDistance) > Math.abs(verticalDistance)
      ? horizontalDistance
      : verticalDistance;
    if (Math.abs(distance) < 45) return;

    if (distance < 0 && activeIndex === 0) {
      showLanding();
      return;
    }

    if (distance > 0 && activeIndex === storyPanels.length - 1) {
      showExperience();
      return;
    }

    showPanel(activeIndex + Math.sign(distance));
  });

  document.addEventListener('keydown', (event) => {
    if (!story) return;

    if (transitionLocked && body.classList.contains('story-active')) {
      event.preventDefault();
      return;
    }

    const heroBounds = hero?.getBoundingClientRect();
    const heroIsVisible =
      !body.classList.contains('story-active') &&
      heroBounds &&
      heroBounds.top <= 1 &&
      heroBounds.bottom >= window.innerHeight - 1;

    if (heroIsVisible && ['ArrowDown', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();
      showStory();
      return;
    }

    const storyIsVisible = body.classList.contains('story-active');
    if (!storyIsVisible) return;

    if (['ArrowDown', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();

      if (activeIndex === storyPanels.length - 1) {
        showExperience();
      } else {
        showPanel(activeIndex + 1);
      }
    }

    if (['ArrowUp', 'PageUp'].includes(event.key) && activeIndex > 0) {
      event.preventDefault();
      showPanel(activeIndex - 1);
    }

    if (['ArrowUp', 'PageUp'].includes(event.key) && activeIndex === 0) {
      event.preventDefault();
      showLanding();
    }
  });
</script>
