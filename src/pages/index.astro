---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import CurrentFocus from '../components/CurrentFocus.astro';
import Foundation from '../components/Foundation.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Michael Mehmet — Senior Software Engineer</title>

    <meta
      name="description"
      content="Michael Mehmet — Senior Software Engineer building robust tools, systems, integrations, and AI."
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <Header />

    <main>
      <Hero />
      <Experience />
      <CurrentFocus />
      <Foundation />
    </main>

    <Footer />
  </body>
</html>