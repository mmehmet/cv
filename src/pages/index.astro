---
import '../styles/global.css';
import experience from '../data/experience.json';
import projects from '../data/projects.json';

const formatDate = (value: string | null) => {
  if (!value) return 'Present';

  return new Intl.DateTimeFormat('en-AU', {
    year: 'numeric',
  }).format(new Date(`${value}-01T00:00:00`));
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Michael Mehmet — Senior Software Engineer</title>
    <meta
      name="description"
      content="Michael Mehmet — Senior Software Engineer building robust tools, systems, integrations, and AI."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-mark" href="/">MM</a>

        <button
          class="nav-toggle"
          type="button"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav id="site-nav" class="site-nav" aria-label="Primary">
          <a href="#focus">Current Focus</a>
          <a href="#experience">Experience</a>
          <a href="#building">Always Building</a>

          <div class="site-nav__utility">
            <a href="/downloads/Michael.Mehmet.pdf" download>Download PDF</a>
            <a href="https://github.com/mmehmet">GitHub</a>
            <a href="https://www.linkedin.com/in/micmehmet">LinkedIn</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero__intro">
          <p class="eyebrow">Senior Software Engineer</p>
          <h1>Michael Mehmet</h1>

          <p class="mission">
            I build robust tools to solve hard problems, always choosing the right
            technologies and methods, while designing systems around them that
            people use, understand, and trust.
          </p>
        </div>

        <div class="hero__demo">
          <div class="section-heading">
            <p class="eyebrow">Under the Hood</p>
            <h2>How an AI voice assistant actually fits together</h2>
            <p>
              A simplified view of the systems involved in turning a telephone call
              into a useful, real-time AI interaction.
            </p>
          </div>

          <div class="system-map">
            <div class="node">
              <span>01</span>
              <strong>Telephone Call</strong>
              <small>Voice enters the system</small>
            </div>

            <div class="connector">→</div>

            <div class="node">
              <span>02</span>
              <strong>Speech Pipeline</strong>
              <small>Audio processing and transcription</small>
            </div>

            <div class="connector">→</div>

            <div class="node">
              <span>03</span>
              <strong>Orchestration</strong>
              <small>Context, tools, state, and routing</small>
            </div>

            <div class="connector">→</div>

            <div class="node">
              <span>04</span>
              <strong>AI Model</strong>
              <small>Open-weight inference on dedicated hardware</small>
            </div>

            <div class="connector">→</div>

            <div class="node">
              <span>05</span>
              <strong>Response</strong>
              <small>Generated speech back to the caller</small>
            </div>
          </div>
        </div>
      </section>

      <section id="focus" class="focus">
        <div class="section-heading">
          <p class="eyebrow">Current Focus</p>
            <div class="role-meta">
              <span>Automed Systems</span>
              <span>{formatDate("2023-10")} – {formatDate(null)}</span>
            </div>
          <h2>Building useful systems, one brick at a time</h2>
        </div>

        <div class="focus__grid">
          <article>
            <h3>AI Voice</h3>
            <p>
              Real-time AI voice interaction over telephone calls, using open-weight
              models and dedicated inference hardware.
            </p>
          </article>

          <article>
            <h3>Product Ownership</h3>
            <p>
              End-to-end ownership of production mobile software, including wearable
              integrations across a broad health and activity ecosystem.
            </p>
          </article>

          <article>
            <h3>Engineering Transformation</h3>
            <p>
              Improving the systems around the software: version control, CI/CD,
              collaboration, support, security, and AI-assisted development.
            </p>
          </article>
        </div>
      </section>

      <section id="experience" class="experience">
        <div class="section-heading">
          <p class="eyebrow">Experience</p>
          <h2>Experience</h2>
          <p>
            A few of the places that shaped how I build software today.
          </p>
        </div>

        <div class="experience-list">
          {
            experience
              .filter((item) =>
                ![
                  'Automed Systems',
                  'Zib Digital',
                  'Mehmetech Pty Ltd',
                ].includes(item.company)
              )
              .map((item) => (
                <details class="experience-card">
                  <summary>
                    <div class="experience-card__heading">
                      <div>
                        <h3>{item.company}</h3>

                        <span class="experience-card__dates">
                          {formatDate(item.start)} – {formatDate(item.end)}
                        </span>
                      </div>

                      <span class="experience-card__toggle" aria-hidden="true">
                        <span class="experience-card__plus">+</span>
                        <span class="experience-card__minus">−</span>
                      </span>
                    </div>

                    <div class="experience-card__tags">
                      {
                        item.technologies.slice(0, 4).map((technology) => (
                          <span>{technology}</span>
                        ))
                      }
                    </div>

                    <p class="experience-card__summary">
                      {item.summary}
                    </p>
                  </summary>

                  <div class="experience-card__detail">
                    <p>{item.description}</p>

                    <div class="experience-card__all-tech">
                      {
                        item.technologies.map((technology) => (
                          <span>{technology}</span>
                        ))
                      }
                    </div>
                  </div>
                </details>
              ))
          }
        </div>
      </section>

      <section id="building" class="building">
        <div class="section-heading">
          <p class="eyebrow">Always Building</p>
          <h2>Things I built because I wanted them to exist.</h2>
        </div>

        <div class="building-list">
          {
            projects.map((project) => (
              <article class="building-item">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Michael Mehmet - Senior Software Engineer</span>

        <div class="site-footer__links">
          <a href="/downloads/MMCV.pdf" download>Download PDF</a>
          <a href="https://github.com/mmehmet/">GitHub</a>
          <a href="https://www.linkedin.com/in/micmehmet/">LinkedIn</a>
        </div>
      </div>
    </footer>
  </body>
  <script>
    const cards = document.querySelectorAll<HTMLDetailsElement>('.experience-card');
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.querySelector<HTMLElement>('.site-nav');

    cards.forEach((card) => {
      card.addEventListener('toggle', () => {
        if (!card.open) return;

        cards.forEach((other) => {
          if (other !== card) {
            other.open = false;
          }
        });
      });
    });

    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</html>